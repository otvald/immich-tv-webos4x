{
	"name": "immich-tv-webos",
	"version": "1.2.2",
	"description": "Read-only Immich photo & video client for LG webOS TVs",
	"author": "Quentin Jean-Amans <quentin.sqja@gmail.com> (https://github.com/Seeky91)",
	"main": "src/index.tsx",
	"scripts": {
		"serve": "npx --yes @enact/cli serve",
		"music:manifest": "node tools/generate-music-manifest.mjs",
		"music:copy": "node tools/generate-music-manifest.mjs --copy-to-dist",
		"pack": "npm run music:manifest && npx --yes @enact/cli pack && npm run music:copy",
		"pack-p": "npm run music:manifest && npx --yes @enact/cli pack -p && node tools/transpile-legacy.mjs && npm run music:copy",
		"pack:modern": "WEBOS_TARGET=modern BROWSERSLIST_ENV=modern node tools/generate-appinfo.mjs && npm run music:manifest && WEBOS_TARGET=modern BROWSERSLIST_ENV=modern npx --yes @enact/cli pack -p && npm run music:copy",
		"pack:legacy": "WEBOS_TARGET=legacy BROWSERSLIST_ENV=legacy node tools/generate-appinfo.mjs && npm run music:manifest && WEBOS_TARGET=legacy BROWSERSLIST_ENV=legacy npx --yes @enact/cli pack -p && WEBOS_TARGET=legacy BROWSERSLIST_ENV=legacy node tools/transpile-legacy.mjs && npm run music:copy",
		"watch": "npx --yes @enact/cli pack --watch",
		"clean": "npx --yes @enact/cli clean",
		"lint": "npx --yes @enact/cli lint .",
		"typecheck": "tsc --noEmit",
		"license": "npx --yes @enact/cli license",
		"test": "npx jest",
		"test-watch": "npx jest --watch",
		"guard": "node tools/architecture-guard.js",
		"audit:legacy": "node tools/audit-bundle.mjs dist/main.js"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Seeky91/immich-tv-webos.git"
	},
	"bugs": {
		"url": "https://github.com/Seeky91/immich-tv-webos/issues"
	},
	"homepage": "https://github.com/Seeky91/immich-tv-webos#readme",
	"keywords": [
		"immich",
		"webos",
		"lg",
		"tv",
		"enact",
		"sandstone",
		"photo-gallery"
	],
	"engines": {
		"npm": ">=6.9.0"
	},
	"enact": {
		"theme": "sandstone",
		"publicUrl": "./"
	},
	"browserslist": {
		"modern": [
			"Chrome >= 79"
		],
		"legacy": [
			"Chrome 53"
		],
		"default": [
			"Chrome >= 79"
		]
	},
	"eslintConfig": {
		"extends": "enact-proxy"
	},
	"eslintIgnore": [
		"node_modules/*",
		"build/*",
		"dist/*"
	],
	"dependencies": {
		"@enact/core": "^4.7.8",
		"@enact/i18n": "^4.7.8",
		"@enact/sandstone": "^2.7.12",
		"@enact/spotlight": "^4.7.8",
		"@enact/ui": "^4.7.8",
		"@enact/webos": "^4.7.8",
		"@tanstack/react-query": "^5.90.14",
		"ilib": "npm:ilib-webos@^14.19.0-webos1",
		"prop-types": "^15.8.1",
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"devDependencies": {
		"@babel/preset-env": "^7.29.7",
		"@babel/preset-react": "^7.29.7",
		"@babel/preset-typescript": "^7.29.7",
		"@testing-library/react": "^16.3.1",
		"@types/jest": "^30.0.0",
		"@types/react": "^18.2.0",
		"@types/react-dom": "^18.2.0",
		"babel-jest": "^30.4.1",
		"baseline-browser-mapping": "^2.9.14",
		"esbuild": "^0.28.0",
		"eslint-config-enact-proxy": "^1.0.7",
		"jest-environment-jsdom": "^30.4.1",
		"typescript": "^5.9.3"
	}
}
